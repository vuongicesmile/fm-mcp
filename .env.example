# Chỉ Workflow Automation API dùng kết nối này.
DATABASE_URL=postgresql+asyncpg://fm_user:change_me@localhost:5432/fm_central

# Chỉ MCP adapter dùng URL này để gọi Workflow Automation API.
FM_WORKFLOW_API_URL=http://localhost:8000
FM_API_TIMEOUT=30
FM_ENV=development

# Audience dự kiến khi API dùng OAuth 2.0/JWT.
FM_WORKFLOW_API_AUDIENCE=fm-workflow-api

# Chỉ để chạy MCP trong local development; production dùng caller token từ transport.
FM_MCP_DEV_USER_ID=local-developer
FM_MCP_DEV_ROLES=fm_admin

# FM MCP owns profiling logic and accesses only this tenant's raw schema.
# Control Plane never receives these warehouse credentials.
FM_PROFILING_CLICKHOUSE_URL=http://localhost:8123
FM_PROFILING_CLICKHOUSE_USER=titan
FM_PROFILING_CLICKHOUSE_PASSWORD=titan-dev
FM_PROFILING_RAW_SCHEMA=t_rmit_fm_raw
FM_PROFILING_ORG_ID=rmit_fm

# SMTP delivery. Local Docker Compose provides Mailpit at http://localhost:8025.
FM_SMTP_HOST=localhost
FM_SMTP_PORT=1025
FM_SMTP_FROM_ADDRESS=fm-workflow@example.test
FM_SMTP_STARTTLS=false
FM_SMTP_MAX_ATTEMPTS=3
FM_SMTP_RETRY_DELAY_SECONDS=60

# FM request-created emails go to this address. Mailpit captures it locally.
FM_REQUEST_NOTIFICATION_EMAIL=fm-requests@example.test

# Collector Orchestration Service (khác database Workflow FM).
FM_COLLECTOR_ORG_ID=rmit_fm
FM_COLLECTOR_SERVICE_URL=http://collector:8021
FM_COLLECTOR_SERVICE_TOKEN=
FM_COLLECTOR_CONTEXT_TOKEN=
FM_COLLECTOR_CONTROL_PLANE_URL=http://titan-api:8000
CAPTURE_PG_HOST=host.docker.internal
CAPTURE_PG_DATABASE=control_plane
CAPTURE_PG_USER=titan
CAPTURE_PG_PASSWORD=
CAPTURE_RUNNER_URL=http://capture-runner:8020
CAPTURE_RUNNER_TOKEN=
TITAN_AIRFLOW_URL=http://airflow-api-server:8080
TITAN_AIRFLOW_PUBLIC_URL=http://localhost:8080
TITAN_AIRFLOW_USER=airflow
TITAN_AIRFLOW_PASSWORD=
