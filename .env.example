# Chỉ Workflow Automation API dùng kết nối này.
DATABASE_URL=postgresql+asyncpg://fm_user:change_me@localhost:5432/fm_central

# Chỉ MCP adapter dùng URL này để gọi Workflow Automation API.
FM_WORKFLOW_API_URL=http://localhost:8000
FM_API_TIMEOUT=30
FM_ENV=development

# Audience dự kiến khi API dùng OAuth 2.0/JWT.
FM_WORKFLOW_API_AUDIENCE=fm-workflow-api
